# Tabletop Agent (暗幕 Anmu) — 环境配置
# 复制此文件为 backend/.env 并填入真实凭据

# ═══ 数据库 ═══
# PostgreSQL:
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/hello_golang

# MySQL (备选):
# DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/tabletop_agent

# ═══ Redis (会话缓存，不可用时自动降级) ═══
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=86400

# ═══ JWT ═══
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ═══ API ═══
API_PREFIX=/api
